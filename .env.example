# Copy to .env and fill in. .env is gitignored.
# Real process env always wins over .env values, so CI / containers can override.

# --- Qdrant ---
# Production (HTTPS reverse proxy in front of Qdrant, no explicit port):
QDRANT_URL=https://qdrant.aizaku.ca
# Local dev (Qdrant direct):
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=images
# QDRANT_API_KEY=your_key_here

# --- Path mapping (optional, for cross-machine setups) ---
# If you index on Windows (paths like Z:\images\...) and search on
# Linux (mount at /mnt/nas), set PATH_PREFIX to the Windows mount root.
# The search app will replace PATH_PREFIX with NAS_IMAGES_BASE when
# looking up files on disk. No re-indexing needed.
# PATH_PREFIX=Z:\images

# --- SigLIP2 model ---
# No config needed. The model weights (ViT-gopt-16-SigLIP2-384, pretrained "webli")
# are downloaded to the HuggingFace Hub default cache, which is the SAME
# location isaac-image-scoring uses — so the two projects share downloads.
#
#   Linux:   ~/.cache/huggingface/hub/
#   Windows: %USERPROFILE%\.cache\huggingface\hub\
#
# If you ever need to redirect to a different drive, set HF_HOME (the
# universal env var both transformers + open_clip honor).

# --- Indexer tuning ---
# LOG_LEVEL=INFO
# Default batch size on a 24GB GPU is 16. Drop to 8 if you OOM.

# --- Qdrant timeouts (milliseconds) ---
# QUERY_TIMEOUT_MS caps the per-request time for normal search calls
# (cheap: ids + payload + scores). Default 10000ms — same bar as
# RECOMMEND_TIMEOUT_MS. 2s was too tight over HTTPS through a reverse
# proxy on a real collection; bump if you still see
# `httpcore.ReadTimeout` in the server log.
# QUERY_TIMEOUT_MS=10000
# RECOMMEND_TIMEOUT_MS caps the per-request time for the discovery
# rabbithole's recommend() call (heavier: Qdrant fetches the
# positive/negative point vectors, computes their mean, then runs
# an HNSW search). Default 10000ms. Bump this if you see
# `httpcore.ReadTimeout` in the server log after 5 successful
# discovery rounds (the recommend call fires from round 6 onward).
# RECOMMEND_TIMEOUT_MS=10000

# --- Custom centroids (optional) ---
# Point at a directory of .pt files produced by isaac-image-scoring's
# `extract` command. Each .pt file becomes a search anchor — visit
# /centroids to see the list, or hit /api/centroids for JSON. Set
# `?centroid=<name>` on / or /api/search to search with a centroid
# as the query vector. Centroid search is mutually exclusive with
# text prompts.
# When unset, the feature is off and /centroids shows an empty state.
# CENTROIDS_DIR=/path/to/centroids
#
# # Reload centroids without restarting the container:
# curl -X POST http://localhost:8000/api/centroids/reload
