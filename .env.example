# Copy to .env and fill in. .env is gitignored.
# Real process env always wins over .env values, so CI / containers can override.

# --- Qdrant ---
# Production (HTTPS reverse proxy in front of Qdrant, no explicit port):
QDRANT_URL=https://qdrant.aizaku.ca
# Local dev (Qdrant direct):
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=images
# QDRANT_API_KEY=your_key_here

# --- Path mapping (optional, for cross-machine setups) ---
# If you index on Windows (paths like Z:\images\...) and search on
# Linux (mount at /mnt/nas), set PATH_PREFIX to the Windows mount root.
# The search app will replace PATH_PREFIX with NAS_IMAGES_BASE when
# looking up files on disk. No re-indexing needed.
# PATH_PREFIX=Z:\images

# --- SigLIP2 model ---
# No config needed. The model weights (ViT-gopt-16-SigLIP2-384, pretrained "webli")
# are downloaded to the HuggingFace Hub default cache, which is the SAME
# location isaac-image-scoring uses — so the two projects share downloads.
#
#   Linux:   ~/.cache/huggingface/hub/
#   Windows: %USERPROFILE%\.cache\huggingface\hub\
#
# If you ever need to redirect to a different drive, set HF_HOME (the
# universal env var both transformers + open_clip honor).

# --- Indexer tuning ---
# LOG_LEVEL=INFO
# Default batch size on a 24GB GPU is 16. Drop to 8 if you OOM.

# --- Qdrant timeouts (milliseconds) ---
# QUERY_TIMEOUT_MS caps the per-request time for normal search calls
# (cheap: ids + payload + scores). Default 10000ms — same bar as
# RECOMMEND_TIMEOUT_MS. 2s was too tight over HTTPS through a reverse
# proxy on a real collection; bump if you still see
# `httpcore.ReadTimeout` in the server log.
# QUERY_TIMEOUT_MS=10000
# RECOMMEND_TIMEOUT_MS caps the per-request time for the discovery
# rabbithole's recommend() call (heavier: Qdrant fetches the
# positive/negative point vectors, computes their mean, then runs
# an HNSW search). Default 10000ms. Bump this if you see
# `httpcore.ReadTimeout` in the server log after 5 successful
# discovery rounds (the recommend call fires from round 6 onward).
# RECOMMEND_TIMEOUT_MS=10000

# --- Search tuning ---
# These knobs were previously hardcoded in search/app.py and
# search/discover.py. Now env-driven so an operator can tune the
# running service without a code change. Defaults match the prior
# values; only set what you want to override.

# Hard cap on total cumulative results served across all pages.
# Once the user scrolls past this, has_more is False even if more
# exist. 5000 is the sweet spot for a 100K-point collection; bump
# to 10000 if you want to push it. Beyond that, virtual scrolling
# on the frontend is the real fix (browser can't hold the DOM).
# MAX_RESULTS_TOTAL=5000

# Bump this when you change any static asset (CSS, JS, images).
# Appended as ?v=N in the templates to force browsers to re-fetch
# instead of serving a stale cache.
# STATIC_ASSETS_VERSION=28

# Per-prompt and per-search caps. Long prompts get dropped before
# they hit the model; too many prompts in one query gets truncated
# (positive side is preferred over negative).
# MAX_PROMPT_CHARS=512
# MAX_PROMPTS_TOTAL=16

# Filename/path-substring filter cardinality guard. When the
# matching set covers more than this fraction of the total cache,
# the Qdrant `HasId` filter is dropped (logged at INFO) and the
# full result set comes back. 0.5 (50%) is the empirical sweet spot
# from prior search-side work: below it, the filter strictly
# improves both latency and relevance; above it, the filter
# competes with HNSW scoring for the same points.
# FILENAME_CARDINALITY_GUARD=0.5

# --- Search Diversity ---
# Diversity is applied to ordinary search only (not Discovery). It retrieves
# a broad candidate pool from offset zero, removes indexed exact/perceptual
# duplicates, then ranks once before pagination.
# DIVERSITY_CANDIDATE_POOL_SIZE=500
# Auto depth uses 500 / 1,000 / 2,000 candidates for Low / Balanced / High.
# The UI also allows explicit 500 / 1,000 / 2,000 / 5,000 depths.
# DIVERSITY_MAX_CANDIDATE_POOL_SIZE=5000
# DIVERSITY_CACHE_TTL_SECONDS=300
# DIVERSITY_CACHE_MAX_ENTRIES=64
# DIVERSITY_DUPLICATE_HAMMING_DISTANCE=10
# Balanced-mode raw cosine-score drop allowed when selecting a more novel result.
# Low and High scale this baseline with their Diversity strength.
# DIVERSITY_RELEVANCE_DROP=0.10

# --- Discovery rabbithole (tuning) ---
# Burst timeline knobs. The seed phase is `DISCOVER_SEED_ROUNDS`
# rounds of random pairs. From round `DISCOVER_SEED_ROUNDS + 1`
# onward, pair source is recommend-based, in bursts of
# `DISCOVER_BURST_SIZE` rounds each. Every burst runs a fresh
# recommend() with all accumulated likes/dislikes.
# DISCOVER_SEED_ROUNDS=10
# DISCOVER_BURST_SIZE=5

# How many ids to sample from the top of recommend before MMR
# re-ranking. The actual burst pool is the much smaller
# `DISCOVER_MMR_POOL_SIZE`. 200 gives MMR real headroom to
# diversify; lower values cluster the pool too tightly.
# DISCOVER_RECOMMEND_OVERFETCH=200

# MMR trade-off: 0 = pure relevance (original clustered behavior),
# 1 = pure diversity (essentially random), 0.5 balances.
# DISCOVER_DIVERSIFY_LAMBDA=0.5

# Burst pool size after MMR. 2 ids per round × burst_size rounds.
# DISCOVER_MMR_POOL_SIZE=10

# A session is dropped after this many seconds of inactivity. Pure
# garbage collection — not a "you should finalize" hint.
# DISCOVER_SESSION_TTL_SECONDS=1800

# --- Dual-store sync (Qdrant ↔ SQLite IndexDB) ---
# After a bulk indexer run, the search container picks up the new
# points within this interval via a background IndexDB refresh.
# Manual refresh still works: POST /api/cache/refresh forces a
# rebuild now. Default 6h; tune shorter for busy libraries, longer
# for static ones.
# INDEX_DB_REFRESH_INTERVAL_SECONDS=21600

# TTL for the lazy path-liveness check at read time. The read path
# validates `Path(path).exists()` (cached for this many seconds)
# before serving a photo, so a deleted file is invisible within the
# TTL. Tune higher if you're on a slow NAS where stat() is expensive.
# PATH_LIVENESS_TTL_SECONDS=60

# --- Custom centroids (optional) ---
# Point at a directory of .pt files produced by isaac-image-scoring's
# `extract` command. Each .pt file becomes a search anchor — visit
# /centroids to see the list, or hit /api/centroids for JSON. Set
# `?centroid=<name>` on / or /api/search to search with a centroid
# as the query vector. Centroid search is mutually exclusive with
# text prompts.
# When unset, the feature is off and /centroids shows an empty state.
# CENTROIDS_DIR=/path/to/centroids
#
# # Reload centroids without restarting the container:
# curl -X POST http://localhost:8000/api/centroids/reload
