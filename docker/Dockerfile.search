# Search-side container. Built on a slim Python image; pulls the
# SigLIP2 model at build time so cold-start is fast.
#
# Build:  docker build -f docker/Dockerfile.search -t image-search .
# Run:    docker run --rm -p 8000:8000 \
#             -e QDRANT_URL=http://qdrant:6333 \
#             -e NAS_IMAGES_BASE=/nas \
#             -v /path/to/nas:/nas:ro \
#             image-search

FROM python:3.12-slim

# System deps for pillow + pillow-heif
RUN apt-get update && apt-get install -y --no-install-recommends \
        libjpeg-dev zlib1g-dev libpng-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Single source of truth for dependencies: pyproject.toml. We copy
# everything needed for `pip install .` (project metadata, README,
# and both packages) and install in one shot. The dep resolution
# is fast on rebuilds because pip's wheel cache is keyed on the
# pyproject content; source-only edits invalidate the layer but
# pip skips re-downloading wheels it already has.
COPY pyproject.toml README.md ./
COPY search ./search
COPY indexer ./indexer
RUN pip install --no-cache-dir .

# Pre-download the SigLIP2 model so cold-start is fast. Bakes the
# weights into a layer so the first request doesn't pay the HF
# download cost. OFF by default because it needs ~15GB free disk
# during build (7.5GB model + ~7.5GB compressed-diff intermediate).
# Opt in with `--build-arg PREWARM_MODEL=1` when you have the disk.
# The model still downloads at first start if you skip this step.
ARG MODEL_NAME=hf-hub:timm/ViT-gopt-16-SigLIP2-384
ARG PREWARM_MODEL=0
RUN if [ "$PREWARM_MODEL" = "1" ]; then \
      python -c "import open_clip; \
        open_clip.create_model_from_pretrained('${MODEL_NAME}'); \
        open_clip.get_tokenizer('${MODEL_NAME}')"; \
    else \
      echo "Skipping model pre-warm (PREWARM_MODEL=${PREWARM_MODEL})."; \
      echo "Model will download from HF Hub on first container start."; \
    fi

ENV MODEL_NAME=${MODEL_NAME} \
    MODEL_DIR=/root/.cache/huggingface \
    DEVICE=cpu \
    NAS_IMAGES_BASE=/nas \
    WEB_UI_URL=http://localhost:8000 \
    LOG_LEVEL=INFO

EXPOSE 8000

CMD ["python", "-m", "search.app"]
